aws_region        = "eu-central-1"
app_secret_arn    = "arn:aws:secretsmanager:REGION:ACCOUNT:secret:ras-backend/dev/app-REPLACE"
authorizer_jwt_secret_arn = "arn:aws:secretsmanager:REGION:ACCOUNT:secret:ras-backend/dev/jwt-signing-REPLACE"
