APP_ENV=development
PORT=9001
DB_HOST=localhost
DB_PORT=5432
DB_NAME=restaurant_db
DB_USER=auth_app
DB_PASSWORD=REPLACE_WITH_LOCAL_AUTH_DB_PASSWORD
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=5
DB_MAX_IDLE_CONNS=2
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SEED_CEO_NAME=CEO
SEED_CEO_EMAIL=ceo@example.test
SEED_CEO_PASSWORD=REPLACE_WITH_STRONG_DEVELOPMENT_PASSWORD
# Optional settings: AUTH_ACCESS_TTL=15m, AUTH_REFRESH_TTL=720h
