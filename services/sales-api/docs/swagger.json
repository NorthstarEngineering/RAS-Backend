{
    "swagger": "2.0",
    "info": {
        "description": "Sales, Shifts, and Discounts API for Restaurant Branch Management.",
        "title": "Sales API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:9006",
    "basePath": "/api/v1",
    "paths": {
        "/sales": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Sales"
                ],
                "summary": "Record Sale",
                "parameters": [
                    {
                        "description": "Sale Data",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/sales.RecordSaleRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/sales.SaleResponse"
                        }
                    }
                }
            }
        },
        "/sales/discounts": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Discounts"
                ],
                "summary": "Create Discount",
                "parameters": [
                    {
                        "description": "Discount Data",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/sales.CreateDiscountRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/sales.DiscountResponse"
                        }
                    }
                }
            }
        },
        "/sales/discounts/{id}/cancel": {
            "patch": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Discounts"
                ],
                "summary": "Cancel Discount",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Discount ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Cancel Reason",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/sales.CancelDiscountRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/sales.DiscountResponse"
                        }
                    }
                }
            }
        },
        "/sales/shifts/open": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Shifts"
                ],
                "summary": "Open Shift",
                "parameters": [
                    {
                        "description": "Open Shift Data",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/sales.OpenShiftRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/sales.ShiftResponse"
                        }
                    }
                }
            }
        },
        "/sales/shifts/{id}/close": {
            "patch": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Shifts"
                ],
                "summary": "Close Shift",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Shift ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/sales.ShiftResponse"
                        }
                    }
                }
            }
        },
        "/sales/shifts/{id}/summary": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Shifts"
                ],
                "summary": "Get Shift Summary",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Shift ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/sales.ShiftSummaryResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "sales.CancelDiscountRequest": {
            "type": "object",
            "required": [
                "reason"
            ],
            "properties": {
                "reason": {
                    "type": "string"
                }
            }
        },
        "sales.ChannelSummary": {
            "type": "object",
            "properties": {
                "channel": {
                    "type": "string"
                },
                "order_count": {
                    "type": "integer"
                },
                "total_sales": {
                    "type": "number"
                }
            }
        },
        "sales.CreateDiscountRequest": {
            "type": "object",
            "required": [
                "amount",
                "reason",
                "shift_id"
            ],
            "properties": {
                "amount": {
                    "type": "number"
                },
                "reason": {
                    "type": "string"
                },
                "shift_id": {
                    "type": "string"
                }
            }
        },
        "sales.DiscountResponse": {
            "type": "object",
            "properties": {
                "amount": {
                    "type": "number"
                },
                "canceled_reason": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "reason": {
                    "type": "string"
                },
                "shift_id": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "sales.ItemSummary": {
            "type": "object",
            "properties": {
                "item_name": {
                    "type": "string"
                },
                "menu_item_id": {
                    "type": "string"
                },
                "total_quantity": {
                    "type": "number"
                },
                "total_sales": {
                    "type": "number"
                }
            }
        },
        "sales.OpenShiftRequest": {
            "type": "object",
            "required": [
                "branch_id",
                "manager_id"
            ],
            "properties": {
                "branch_id": {
                    "type": "string"
                },
                "manager_id": {
                    "type": "string"
                },
                "opening_float": {
                    "type": "number"
                }
            }
        },
        "sales.RecordSaleRequest": {
            "type": "object",
            "required": [
                "channel",
                "items",
                "shift_id"
            ],
            "properties": {
                "channel": {
                    "type": "string",
                    "enum": [
                        "RESTAURANT",
                        "DELIVERY"
                    ]
                },
                "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/sales.SaleItemRequest"
                    }
                },
                "shift_id": {
                    "type": "string"
                }
            }
        },
        "sales.SaleItemRequest": {
            "type": "object",
            "required": [
                "menu_item_id",
                "quantity"
            ],
            "properties": {
                "menu_item_id": {
                    "type": "string"
                },
                "quantity": {
                    "type": "number"
                }
            }
        },
        "sales.SaleItemResponse": {
            "type": "object",
            "properties": {
                "menu_item_id": {
                    "type": "string"
                },
                "quantity": {
                    "type": "number"
                },
                "total_price": {
                    "type": "number"
                },
                "unit_price": {
                    "type": "number"
                }
            }
        },
        "sales.SaleResponse": {
            "type": "object",
            "properties": {
                "channel": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "discount_amount": {
                    "type": "number"
                },
                "gross_amount": {
                    "type": "number"
                },
                "id": {
                    "type": "string"
                },
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/sales.SaleItemResponse"
                    }
                },
                "net_amount": {
                    "type": "number"
                },
                "shift_id": {
                    "type": "string"
                }
            }
        },
        "sales.ShiftResponse": {
            "type": "object",
            "properties": {
                "branch_id": {
                    "type": "string"
                },
                "closed_at": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "manager_id": {
                    "type": "string"
                },
                "opened_at": {
                    "type": "string"
                },
                "opening_float": {
                    "type": "number"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "sales.ShiftSummaryResponse": {
            "type": "object",
            "properties": {
                "channels": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/sales.ChannelSummary"
                    }
                },
                "gross_sales": {
                    "type": "number"
                },
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/sales.ItemSummary"
                    }
                },
                "net_sales": {
                    "type": "number"
                },
                "shift_id": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "total_discounts": {
                    "type": "number"
                },
                "total_orders": {
                    "type": "integer"
                }
            }
        }
    }
}